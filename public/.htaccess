<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── Canonical domain: force https://accrocar.com (no www, no http) ────────
  # One rule handles all variants: http://www, https://www, http://non-www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://accrocar.com%{REQUEST_URI} [R=301,L]

  # ── Localized SEO shells (fr/es/ro/nl) ────────────────────────────────────
  # If a generated shell exists at <path>/index.html, serve it INTERNALLY
  # with HTTP 200 (no redirect) before the SPA fallback. Real files (assets,
  # sitemap.xml, robots.txt) fail the !-f test and are untouched. EN routes
  # and the standalone FR landing pages have no shell file → conditions fail
  # → unchanged SPA fallback below. Runs before mod_dir, so no DirectorySlash
  # trailing-slash 301. Internal rewrite to a real file → no loop.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # ── React Router SPA fallback ─────────────────────────────────────────────
  # Serve index.html for any path that is not a real file or directory.
  # This makes /fleet, /fleet/:id, /contact, etc. return HTTP 200.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# ── Cache: long-lived immutable assets ────────────────────────────────────────
<IfModule mod_headers.c>
  # Vite hashes JS/CSS filenames — safe to cache 1 year
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images: 1 year (filenames are stable; update filename if image changes)
  <FilesMatch "\.(webp|avif|png|jpg|jpeg|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML: never cache (always revalidate so new deployments take effect)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Sitemap and robots: short cache so Google picks up changes quickly
  <FilesMatch "(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # ── Security headers ───────────────────────────────────────────────────────
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript \
    application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

# ── MIME types for modern image formats ───────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
